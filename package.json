{
  "name": "will-d-wang",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check:icons": "node scripts/check-icons.mjs",
    "prebuild": "node scripts/check-icons.mjs",
    "build": "next build",
    "postbuild": "pagefind --site out --output-path out/_pagefind",
    "start": "npx serve@latest out",
    "lint": "eslint .",
    "prepare": "husky",
    "eslint-fix": "eslint . --fix",
    "eslint-pre-commit": "eslint --fix",
    "mdlint-fix": "markdownlint-cli2 --fix '**/*.md' '!.trunk' '!node_modules'",
    "mdlint-pre-commit": "markdownlint-cli2 --fix",
    "lint-staged": "lint-staged"
  },
  "repository": {
    "type": "module",
    "url": "https://github.com/will-d-wang/will-d-wang.github.io"
  },
  "author": "Will D. Wang",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "bugs": {
    "url": "https://github.com/will-d-wang/will-d-wang.github.io/issues"
  },
  "homepage": "https://github.com/will-d-wang/will-d-wang.github.io#readme",
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": "pnpm run eslint-pre-commit",
    "*.{md,mdx}": "pnpm run mdlint-pre-commit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "^0.23.3",
    "pagefind": "^1.5.2",
    "prettier": "3.9.9",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
